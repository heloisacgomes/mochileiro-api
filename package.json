{
  "name": "mochileiro-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST de planejamento de viagens com integração opcional ao Gemini",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "node --check src/*.js && node --check tests/*.test.js",
    "test": "node --test tests/*.test.js",
    "coverage": "node --experimental-test-coverage --test tests/*.test.js",
    "test:coverage": "node scripts/check-coverage.js"
  }
}
